; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="OpenScreamer"
config/description="OpenScreamer: plays THE SCREAMER (Magical Zoo / ASCII, PC-9801, 1986) from your own copy. Unofficial, non-commercial."
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[audio]

general/text_to_speech=true

[debug]

gdscript/warnings/redundant_await=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=640
window/size/viewport_height=440
window/size/window_width_override=1280
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/handheld/orientation=4

